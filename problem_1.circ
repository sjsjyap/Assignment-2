    <tool name="Pin"/>
    <tool name="Pin">
      <a name="facing" val="west"/>
      <a name="type" val="output"/>
    </tool>
    <sep/>
    <tool name="NOT Gate"/>
    <tool name="AND Gate"/>
    <tool name="OR Gate"/>
    <tool name="XOR Gate"/>
    <tool name="NAND Gate"/>
    <tool name="NOR Gate"/>
    <sep/>
    <tool name="D Flip-Flop"/>
    <tool name="Register"/>
  </toolbar>
  <circuit name="main">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="main"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="1.0"/>
    <comp lib="0" loc="(260,200)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="width" val="3"/>
    </comp>
    <comp lib="0" loc="(570,200)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="type" val="output"/>
      <a name="width" val="8"/>
    </comp>
    <comp loc="(520,200)" name="prob3"/>
    <wire from="(260,200)" to="(300,200)"/>
    <wire from="(520,200)" to="(570,200)"/>
  </circuit>
  <circuit name="prob1_project">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="prob1_project"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="1.0"/>
  </circuit>
  <circuit name="prblem3_project">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="prblem3_project"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="1.0"/>
  </circuit>
  <vhdl appearance="logisim_evolution" name="prob1">library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
&#13;
entity prob1 is&#13;
    port(&#13;
        a, b, c, d : in std_logic;&#13;
        out1, out2 : out std_logic&#13;
    );&#13;
end entity prob1;&#13;
&#13;
architecture bhv of prob1 is&#13;
begin&#13;
    out1 &lt;= a and b and c and d;&#13;
    out2 &lt;= a or b or c or d;&#13;
end architecture bhv;&#13;
</vhdl>
  <vhdl appearance="logisim_evolution" name="prob3">library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
&#13;
entity prob3 is&#13;
    port(&#13;
        sel     : in std_logic_vector(2 downto 0);&#13;
        display : out std_logic_vector(7 downto 0)&#13;
    );&#13;
end entity prob3;&#13;
&#13;
architecture bhv of prob3 is&#13;
begin&#13;
    process(sel)&#13;
    begin&#13;
        -- 7-segment 순서: a,b,c,d,e,f,g,dp&#13;
        case sel is&#13;
            when "000" =&gt; display &lt;= "11101110"; -- A&#13;
            when "001" =&gt; display &lt;= "00111110"; -- b&#13;
            when "010" =&gt; display &lt;= "10011100"; -- C&#13;
            when "011" =&gt; display &lt;= "01111010"; -- d&#13;
            when "100" =&gt; display &lt;= "10001110"; -- F&#13;
            when "101" =&gt; display &lt;= "10111110"; -- g (또는 9)&#13;
            when others =&gt; display &lt;= "00000000"; -- OFF&#13;
        end case;&#13;
    end process;&#13;
end architecture bhv;&#13;
</vhdl>
